/**app.wxss**/
page {
  --primary-color: #3498db;
  --secondary-color: #f39c12;
  --bg-color: #f5f5f5;
  --correct-color: #2ecc71;
  --wrong-color: #e74c3c;
  --text-color: #333;
  --light-text: #888;
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx;
  box-sizing: border-box;
} 

.btn {
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.btn-primary {
  background-color: var(--primary-color);
  color: white;
}

.btn-secondary {
  background-color: var(--secondary-color);
  color: white;
}

.btn-default {
  background-color: #ddd;
  color: #666;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  margin: 20rpx 0;
  text-align: center;
}

.subtitle {
  font-size: 36rpx;
  font-weight: bold;
  margin: 16rpx 0;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin: 20rpx 0;
  width: 100%;
  box-sizing: border-box;
} 
