/* game.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-color);
  padding: 0;
}

.timer-container {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

.timer {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--primary-color);
  background-color: white;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.timer-warning {
  color: white;
  background-color: var(--wrong-color);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
  }
}

.score-container {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  z-index: 10;
}

.score {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
  background-color: rgba(255, 255, 255, 0.8);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.word-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
}

.word {
  font-size: 72rpx;
  font-weight: bold;
  color: var(--text-color);
  text-align: center;
  padding: 40rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
  min-width: 50%;
}

/* 新样式：触控区域 */
.action-areas {
  display: flex;
  height: 30vh;
  width: 100%;
}

.action-area {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.correct-area {
  background-color: rgba(46, 204, 113, 0.1);
  border-top: 8rpx solid var(--correct-color);
}

.skip-area {
  background-color: rgba(231, 76, 60, 0.1);
  border-top: 8rpx solid var(--wrong-color);
}

.area-hint {
  position: absolute;
  top: 40rpx;
  opacity: 0.6;
}

.hint-icon {
  font-size: 60rpx;
  color: var(--text-color);
}

.correct-area .hint-icon {
  color: var(--correct-color);
}

.skip-area .hint-icon {
  color: var(--wrong-color);
}

/* 提示文字 */
.action-hints {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  color: var(--light-text);
  background-color: white;
}

.left-hint, .right-hint {
  opacity: 0.8;
}

/* 点击效果 */
.action-area:active, .action-area.active {
  opacity: 0.7;
}

.correct-area.active {
  background-color: rgba(46, 204, 113, 0.3);
}

.skip-area.active {
  background-color: rgba(231, 76, 60, 0.3);
}

/* 在正确/跳过区域添加波浪效果 */
@keyframes ripple {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

.correct-area.active .area-hint::after,
.skip-area.active .area-hint::after {
  content: '';
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  z-index: -1;
  animation: ripple 0.6s ease-out;
}

.correct-area.active .area-hint::after {
  background-color: rgba(46, 204, 113, 0.4);
}

.skip-area.active .area-hint::after {
  background-color: rgba(231, 76, 60, 0.4);
} 