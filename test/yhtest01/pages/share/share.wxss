/* share.wxss */
.container {
  padding: 30rpx;
  background-color: white;
}

.share-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-title {
  font-size: 32rpx;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.share-score {
  font-size: 120rpx;
  font-weight: bold;
  color: var(--primary-color);
  line-height: 1;
  margin: 20rpx 0;
}

.share-subtitle {
  font-size: 32rpx;
  color: var(--text-color);
  margin-bottom: 40rpx;
}

/* 得分详情样式 */
.score-details {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin: 20rpx 0 40rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

.detail-value {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 10rpx;
}

.detail-label {
  font-size: 28rpx;
  color: var(--light-text);
}

.detail-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #eee;
}

.share-image-container {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 20rpx 0;
  background-color: #eee;
}

.share-image {
  width: 100%;
  height: 100%;
}

/* 替代图片的样式 */
.share-image-placeholder {
  width: 100%;
  height: 100%;
  background-color: var(--primary-color);
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
}

.share-buttons {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-platforms {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 40rpx;
}

.share-platform-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.platform-icon-placeholder {
  width: 80rpx;
  height: 80rpx;
  background-color: var(--secondary-color);
  color: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.save-btn, .home-btn {
  width: 90%;
  height: 90rpx;
  line-height: 90rpx;
  margin-bottom: 30rpx;
  font-size: 32rpx;
} 