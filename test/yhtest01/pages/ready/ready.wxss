/* ready.wxss */
.container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: var(--primary-color);
  color: white;
}

.ready-text {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
}

.countdown {
  font-size: 180rpx;
  font-weight: bold;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 40rpx 0 60rpx;
}

.tip-text {
  font-size: 32rpx;
  text-align: center;
  max-width: 80%;
  line-height: 1.5;
} 