/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  position: relative;
  height: 100%;
}

.logo-container {
  margin-bottom: 60rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
}

.title-container {
  margin-bottom: 80rpx;
}

.game-title {
  font-size: 72rpx;
  font-weight: bold;
  color: var(--primary-color);
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.button-container {
  width: 70%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.start-btn {
  width: 100%;
  height: 100rpx;
  margin-bottom: 30rpx;
  font-size: 36rpx;
}

.rules-btn {
  width: 80%;
  height: 80rpx;
  font-size: 28rpx;
}

.settings-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
}

.settings-btn image {
  width: 100%;
  height: 100%;
}

/* 新增样式-文字替代logo */
.logo-text {
  width: 200rpx;
  height: 200rpx;
  background-color: var(--primary-color);
  color: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 64rpx;
  font-weight: bold;
}

/* 新增样式-文字替代设置图标 */
.settings-text {
  background-color: var(--primary-color);
  color: white;
  border-radius: 50%;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
}
